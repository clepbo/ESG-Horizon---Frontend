# Demo build.
#
#   cp .env.demo.example .env.local && yarn build && yarn start
#
# NEXT_PUBLIC_* values are compiled into the bundle at build time, so changing
# any of these means rebuilding, not restarting.

# Serves every API response from the dataset in lib/demo/data. No backend and
# no database are contacted. Unset this and the app talks to a real API again.
NEXT_PUBLIC_DEMO_MODE=true

# Not used in demo mode — the adapter intercepts before any network call —
# but left here so the switch back to a live backend is a one-line change.
# NEXT_PUBLIC_API_BASE_URL=https://your-api-host

# lib/supabase.ts throws at import time without these, which breaks the build.
# Supabase only backs social login, which the demo does not use.
NEXT_PUBLIC_SUPABASE_URL=https://demo-placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-placeholder-anon-key
